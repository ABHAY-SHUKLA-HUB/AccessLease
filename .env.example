# ==============================================================================
# AccessLease — Environment Variables Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER store real secrets, production credentials, or connection strings in this file.
# - Copy this file to '.env' or Azure Functions 'local.settings.json' for local development.
# - Ensure that '.env' and 'local.settings.json' are ignored by version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
AZURE_FUNCTIONS_ENVIRONMENT=development
PORT=7071
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# 2. Azure Functions Core Settings (local.settings.json mapping)
# ------------------------------------------------------------------------------
FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=UseDevelopmentStorage=true

# ------------------------------------------------------------------------------
# 3. Microsoft SQL Server / Azure SQL Database Configuration
# Supported variables: SQL_* or AZURE_SQL_* aliases
# ------------------------------------------------------------------------------
SQL_SERVER=your-server-name.database.windows.net
SQL_DATABASE=accesslease-db
SQL_PORT=1433
SQL_USER=your-sql-admin-username
SQL_PASSWORD=your-secure-sql-password
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT=30000

# Alternate Aliases for Azure SQL:
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=accesslease-db
AZURE_SQL_PORT=1433
AZURE_SQL_USER=your-sql-admin-username
AZURE_SQL_PASSWORD=your-secure-sql-password
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_CONNECTION_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 4. Microsoft Entra ID (Azure Active Directory) Authentication
# ------------------------------------------------------------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-entra-app-client-secret-placeholder
ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 5. Azure Blob Storage Configuration (Proof Artifacts & Logs)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccountname
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key-placeholder
AZURE_STORAGE_CONTAINER_NAME=accesslease-revocation-proofs
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccountname;AccountKey=your-storage-account-key-placeholder;EndpointSuffix=core.windows.net

# ------------------------------------------------------------------------------
# 6. Microsoft Power BI Embedded & Governance Analytics
# ------------------------------------------------------------------------------
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
POWERBI_REPORT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_SECRET=your-powerbi-client-secret-placeholder
POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000

